VITE_API_BASE_URL=http://localhost:8000
# Prototype run data is used until the execution API is ready.
# Set to false to use POST /runs, GET /runs, and GET /dashboard/me.
VITE_USE_MOCK_RUNS=true
# Keep deployment and token workflows local until backend endpoints are available.
VITE_USE_MOCK_DEPLOYMENTS=true
# Admin console uses shared prototype data until governance APIs are ready.
VITE_USE_MOCK_ADMIN=true
