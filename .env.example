ENVIRONMENT=development
DATABASE_URL=postgresql://promptvault:promptvault@localhost:5432/promptvault
DATABASE_ROLE=
TEST_DATABASE_URL=postgresql://promptvault:promptvault@localhost:5432/promptvault_test
POSTGRES_DB=promptvault
POSTGRES_USER=promptvault
POSTGRES_PASSWORD=promptvault
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173
VITE_API_URL=http://localhost:8000
SECRET_KEY=change-me
PROVIDER_ENCRYPTION_KEY=change-me-provider-encryption-key
ACCESS_TOKEN_TTL_MINUTES=30
JWT_ISSUER=promptvault
JWT_AUDIENCE=promptvault-web
CORS_ORIGINS=http://localhost:5173
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
DATABASE_HEALTH_TIMEOUT_SECONDS=2
PROVIDER_TIMEOUT_SECONDS=30
MAX_CONCURRENT_RUNS_PER_USER=4
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MAX_REQUEST_BODY_BYTES=1048576
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_RESET_RATE_LIMIT_REQUESTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=300
# Required in production so all API replicas share authentication limits.
# RATE_LIMIT_REDIS_URL=rediss://user:password@redis.example.com:6379/0
LOG_LEVEL=INFO
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Configure Gmail SMTP using a Google App Password (not your normal account password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM_EMAIL=your-address@gmail.com
