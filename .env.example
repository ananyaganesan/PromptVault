ENVIRONMENT=development
DATABASE_URL=postgresql://promptvault:promptvault@localhost:5432/promptvault
TEST_DATABASE_URL=postgresql://promptvault:promptvault@localhost:5432/promptvault_test
API_PORT=8000
VITE_API_URL=http://localhost:8000
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=30
JWT_ISSUER=promptvault
JWT_AUDIENCE=promptvault-web
CORS_ORIGINS=http://localhost:5173
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
DATABASE_HEALTH_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password
