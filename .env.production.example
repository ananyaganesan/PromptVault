# Public hostname already pointed at the production host.
DOMAIN=promptvault.example.com
SECRET_DIR=/secure/promptvault
IMAGE_TAG=local

# Used only by the one-shot `bootstrap` profile. Store the password in
# SECRET_DIR/production_admin_password with mode 0400.
PRODUCTION_ADMIN_EMAIL=owner@example.com
PRODUCTION_ADMIN_DISPLAY_NAME=Production Owner

# Password-reset delivery. Put the password only in SECRET_DIR/smtp_password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_FROM_EMAIL=sender@example.com
SMTP_STARTTLS=true
SMTP_SSL=false

# Scheduled local dumps and encrypted off-site restic replication.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
RESTIC_REPOSITORY=s3:https://object-storage.example.com/promptvault
RESTIC_INTERVAL_SECONDS=86400
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12

PROMETHEUS_RETENTION=15d
MAINTENANCE_INTERVAL_SECONDS=3600
STALE_RESERVATION_MINUTES=10
SECURITY_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_DAYS=30
